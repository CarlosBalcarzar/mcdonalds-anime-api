PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mcd_anime
# Solo para migraciones/semilla, opcional si DATABASE_URL es propietario local
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@localhost:5432/mcd_anime
# Inicializa el superadministrador local al ejecutar npm run seed
# ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA
# Opcionales: habilitan autenticación externa en lugar de autenticación local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# PEM de la CA de Supabase si la cadena no usa una raíz del sistema
# DATABASE_CA_CERT=
